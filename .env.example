# ──────────────────────────────────────────────
# VARIÁVEIS DE AMBIENTE — copie para .env e preencha com valores reais.
# NUNCA commite o arquivo .env no repositório.
# ──────────────────────────────────────────────

# ID da planilha Google Sheets (encontrado na URL da planilha)
SPREADSHEET_ID=1AbCdEfGhIjKlMnOpQrStUvWxYz_EXEMPLO_ID_AQUI

# Caminho para o arquivo de credenciais da Service Account do Google
# Em produção (Render.com) use a variável GOOGLE_CREDENTIALS_JSON (ver abaixo)
GOOGLE_CREDENTIALS_PATH=credentials.json

# (Opcional — produção) Conteúdo JSON da credencial como string, para evitar
# montar arquivos em servidores efêmeros. Se definida, tem prioridade sobre
# GOOGLE_CREDENTIALS_PATH.
# GOOGLE_CREDENTIALS_JSON={"type":"service_account","project_id":"..."}
